# Server-only credentials. The Supabase anon key is safe for RLS-backed access,
# but this project still keeps all database calls behind /api/rsvp.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Used to generate absolute Open Graph URLs in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
