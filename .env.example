# Server-only configuration. Use the low-privilege publishable key; never place
# a secret/service_role key here. Database calls stay behind /api/rsvp.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Temporary backwards-compatible fallback supported by the code:
# SUPABASE_ANON_KEY=your-legacy-anon-or-publishable-key

# Used to generate absolute Open Graph URLs in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
