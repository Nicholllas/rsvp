# Server-only configuration. Use the low-privilege publishable key; never place
# a secret/service_role key here. Database calls stay behind /api/rsvp.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Temporary backwards-compatible fallback supported by the code:
# SUPABASE_ANON_KEY=your-legacy-anon-or-publishable-key

# Service Role Key - ONLY for local seed script (scripts/seed-guests.mjs)
# DO NOT commit this to Git or deploy to Vercel!
# Get this from Supabase Dashboard > Settings > API > service_role key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Used to generate absolute Open Graph URLs in production and guest invitation links
# Local: http://localhost:3000
# Production: https://your-domain.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
